<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the keys Xcode generates from INFOPLIST_KEY_* build settings. -->
	<key>NSBonjourServices</key>
	<array>
		<string>_smb._tcp</string>
		<string>_webdav._tcp</string>
		<string>_webdavs._tcp</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- NAS / WebDAV servers on the LAN are usually plain HTTP or self-signed HTTPS. -->
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Optional build-time TMDb key (CI secret TMDB_API_KEY); users can also enter one in Settings. -->
	<key>XTTMDbAPIKey</key>
	<string>$(TMDB_API_KEY)</string>
</dict>
</plist>
